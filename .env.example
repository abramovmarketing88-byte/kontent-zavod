# Cursor SDK — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# YouTube Data API v3 — https://console.cloud.google.com/
YOUTUBE_API_KEY=...

# YouTube Shorts upload (OAuth2 — API key cannot upload)
# Scope: https://www.googleapis.com/auth/youtube.upload
# YOUTUBE_CLIENT_ID=....apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=...
# YOUTUBE_REFRESH_TOKEN=...
# YOUTUBE_UPLOAD=true
# YOUTUBE_PRIVACY=public
# YOUTUBE_CATEGORY_ID=22

# Pexels — https://www.pexels.com/api/
PEXELS_API_KEY=...

# Fallback LLM when Cursor agent fails (optional)
# OpenRouter (рекомендуется) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini

# Или напрямую OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Telegram — тот же бот, что в MCP (отправка в личку)
TELEGRAM_BOT_TOKEN=...
TELEGRAM_OWNER_CHAT_ID=123456789
TELEGRAM_NOTIFY=true

# Telegram Business Stories (bot as assistant → postStory)
# Enable can_manage_stories for the bot in Business settings.
# Connection id is auto-discovered from getUpdates, or set explicitly:
# TELEGRAM_BUSINESS_CONNECTION_ID=...
# TELEGRAM_STORY_UPLOAD=true
# TELEGRAM_STORY_ACTIVE_PERIOD=86400

# HeyGen — https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=sk_V2_...
HEYGEN_AVATAR_ID=

# faceless = Pexels B-roll | heygen = avatar only | hybrid = avatar intro + Pexels
RENDERER=hybrid
HEYGEN_INTRO_SEC=8

# Pipeline settings
MAX_VIDEOS_PER_RUN=1
DAILY_AT=09:00
SCHEDULE_TZ=Europe/Moscow
# SCHEDULE_HOURS=6
WHISPER_MODEL=base
TRANSCRIBE_BACKEND=faster_whisper
# TRANSCRIBE_BACKEND=openai  # for servers without AVX (needs OPENAI_API_KEY)
OPENAI_WHISPER_MODEL=whisper-1

# Target output duration (seconds)
TARGET_DURATION_MIN=30
TARGET_DURATION_MAX=40

# Instagram discovery (optional)
IG_USERNAME=
IG_PASSWORD=
# IG_SESSION_FILE=/app/data/ig_session

# Proxy (mihomo/Clash on host). Entrypoint clears dead proxy unless required.
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
PROXY_REQUIRED=false

# Optional Netscape cookies file for yt-dlp (helps with YouTube 503)
# YTDLP_COOKIES_FILE=/app/data/youtube.cookies.txt

# Retry / reclaim policy
SOURCE_MAX_FAILS=3
SOURCE_STALE_HOURS=6

# Author welcome / soft reminders (channel + DM). Set false to disable.
# AUTHOR_NUDGE=true

# Push last-run report to GitHub branch `run-reports` (for Cloud Agent debug)
REPORTS_GIT_PUSH=true
# Optional PAT with `contents: write` if deploy key is read-only:
# GITHUB_TOKEN=ghp_...
