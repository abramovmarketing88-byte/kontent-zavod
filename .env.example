# Cursor SDK — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# YouTube Data API v3 — https://console.cloud.google.com/
YOUTUBE_API_KEY=...

# Pexels — https://www.pexels.com/api/
PEXELS_API_KEY=...

# Fallback LLM when Cursor agent fails (optional)
# OpenRouter (рекомендуется) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini

# Или напрямую OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Telegram — тот же бот, что в MCP (отправка в личку)
TELEGRAM_BOT_TOKEN=...
TELEGRAM_OWNER_CHAT_ID=123456789
TELEGRAM_NOTIFY=true

# HeyGen — https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=sk_V2_...
HEYGEN_AVATAR_ID=

# faceless = Pexels B-roll | heygen = avatar only | hybrid = avatar intro + Pexels
RENDERER=hybrid
HEYGEN_INTRO_SEC=8

# Pipeline settings
MAX_VIDEOS_PER_RUN=1
DAILY_AT=09:00
SCHEDULE_TZ=Europe/Moscow
# SCHEDULE_HOURS=6
WHISPER_MODEL=base
TRANSCRIBE_BACKEND=faster_whisper
# TRANSCRIBE_BACKEND=openai  # for servers without AVX (needs OPENAI_API_KEY)
OPENAI_WHISPER_MODEL=whisper-1

# Target output duration (seconds)
TARGET_DURATION_MIN=30
TARGET_DURATION_MAX=40

# Instagram discovery (optional)
IG_USERNAME=
IG_PASSWORD=
# IG_SESSION_FILE=/app/data/ig_session

PROJECT_ROOT=.

# Push last-run report to GitHub branch `run-reports` (for Cloud Agent debug)
REPORTS_GIT_PUSH=true
# Optional PAT with `contents: write` if deploy key is read-only:
# GITHUB_TOKEN=ghp_...
